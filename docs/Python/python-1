def ask_ok(prompt, retries=3, reminder='please try again!'):
    """询问用户确认的函数"""
    while True:
        replay = input(prompt)
        if replay in ('y', 'ye', 'yes'):
            return True
        if replay in ('n', 'no', 'nop', 'nope'):
            return False
        retries = retries -1
        if retries < 0:
            raise ValueError('you out')
        print(reminder)
